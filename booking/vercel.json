{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "includeFiles": "{public,src}/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api?__path=/$1" }],
  "crons": [{ "path": "/api/cron/reminders", "schedule": "* * * * *" }]
}
