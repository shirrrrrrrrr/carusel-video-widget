# ---- Core ----
PORT=5000
# Public URL of this app (used for Google OAuth redirect + links in emails)
BASE_URL=http://localhost:5000
# Password for the /admin dashboard
ADMIN_PASSWORD=change-me
# Long random string; used to encrypt Google tokens and sign sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# SQLite file location
DB_PATH=./data/booking.db

# ---- Google (Calendar + optional Gmail sending) ----
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BASE_URL}/admin/google/callback
# Enable "Google Calendar API" (and "Gmail API" if EMAIL_PROVIDER=gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email ----
# gmail  = send from one of your connected Google accounts (no extra service needed)
# resend = send through https://resend.com
# none   = disable email
EMAIL_PROVIDER=gmail
# For gmail: which connected account sends (defaults to the account that owns the default calendar)
EMAIL_FROM_GOOGLE_ACCOUNT=
RESEND_API_KEY=
RESEND_FROM="Your Name <bookings@yourdomain.com>"

# ---- WhatsApp ----
# twilio | meta | none
WHATSAPP_PROVIDER=none
# Twilio: https://www.twilio.com/docs/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional approved Content template SID (needed for messages outside the 24h window in production).
# Variables sent: 1=name 2=meeting name 3=date/time 4=link
TWILIO_CONTENT_SID=
# Meta WhatsApp Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Approved template name + language. Body params: {{1}}=name {{2}}=meeting name {{3}}=date/time {{4}}=link
META_WA_TEMPLATE=meeting_reminder
META_WA_TEMPLATE_LANG=he

# ---- Zoom (optional) ----
# With these set, every Zoom booking gets its own Zoom meeting created automatically.
# Without them, Zoom bookings use the personal Zoom link you enter in the meeting type.
# Create a "Server-to-Server OAuth" app at https://marketplace.zoom.us/ with scope meeting:write:meeting:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Meeting transcriber ----
# Shared secret for the generic transcript webhook: POST ${BASE_URL}/api/webhooks/transcript?key=...
TRANSCRIPT_WEBHOOK_SECRET=
# Fireflies.ai (optional): API key + webhook secret (Settings → Developer settings)
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# ---- Summary tool ----
# The transcript is POSTed here as JSON when you click "Generate summary" in the dashboard.
# The tool may answer synchronously with {"summary": "..."} or later call
# POST ${BASE_URL}/api/webhooks/summary?key=TRANSCRIPT_WEBHOOK_SECRET  with {"transcript_id": 1, "summary": "..."}
SUMMARY_API_URL=
SUMMARY_API_KEY=
